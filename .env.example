# Public https URL of this server (e.g. from `cloudflared tunnel --url http://localhost:3000`).
# Whop redirects buyers here and Terac participants open /rate/... on it.
BASE_URL=https://your-tunnel.trycloudflare.com
PORT=3000

# Claude: powers every capybara agent
ANTHROPIC_API_KEY=

# Whop: Dashboard → Developer → Generate new key. Company id starts with biz_.
WHOP_API_KEY=
WHOP_COMPANY_ID=
# Dashboard → Developer → Webhooks → add ${BASE_URL}/webhooks/whop (API version v1, event payment.succeeded); copy the ws_... secret
WHOP_WEBHOOK_SECRET=
# Optional: an existing product to attach plans to (otherwise one product per gig is created)
WHOP_PRODUCT_ID=
# Set to 1 with sandbox keys to test checkout without real money
WHOP_SANDBOX=0

# Terac: Settings → API Keys (starts with tk_). Redeem the hackathon credits first.
TERAC_API_KEY=
TERAC_PARTICIPANTS=15
TERAC_MAX_BUDGET_USD=150

# Exa: competitor research (coupon EXA50ZEROHUMAN)
EXA_API_KEY=

# AssemblyAI: demo video narration
ASSEMBLYAI_API_KEY=
NARRATOR_VOICE=eve

# Optional
SUPPORT_EMAIL=support@capygigs.app
ADMIN_TOKEN=
SLACK_WEBHOOK_URL=
CEO_INTERVAL_MIN=20
TERAC_POLL_MIN=3
